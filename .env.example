# 이 파일을 복사해 .env 로 만들고 값을 채우세요.
# Neon Postgres 연결 문자열 — 다이렉트(언풀드) 엔드포인트 사용.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# JWT 서명 키 — 32바이트 이상 랜덤값. 예: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# 시드 계정 비밀번호 — 두 계정(kcs___chang, yekorita)이 공유한다.
SEED_CHANG_PASSWORD="change-me"

# 파일 스토리지: local(기본) | r2.
# STORAGE_DRIVER="local"
# STORAGE_LOCAL_DIR=".storage"
# 업로드 누적 용량 상한(바이트). R2 무료 10GB 대비 여유(기본 9.5GB). 초과 시 업로드 차단.
# STORAGE_MAX_BYTES="9500000000"

# Cloudflare R2 (STORAGE_DRIVER=r2 일 때 필수) — prod 이미지 스토리지
# R2_ACCOUNT_ID="..."
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET="diary-photos"

# 공휴일(달력 빨간날) — 공공데이터포털 천문연 특일정보 API 인증키(Decoding 키).
# 미설정 시 공휴일 색은 표시되지 않는다(앱 동작엔 영향 없음).
# DATA_GO_KR_KEY="..."
