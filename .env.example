# 이 파일을 복사해 .env 로 만들고 값을 채우세요.
# Neon Postgres 연결 문자열 — 다이렉트(언풀드) 엔드포인트 사용.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# JWT 서명 키 — 32바이트 이상 랜덤값. 예: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# 시드 계정 비밀번호 — 두 계정(kcs___chang, yekorita)이 공유한다.
SEED_CHANG_PASSWORD="change-me"

# 파일 스토리지: local(기본) | r2.
# STORAGE_DRIVER="local"
# STORAGE_LOCAL_DIR=".storage"
# 업로드 누적 용량 상한(바이트). R2 무료 10GB 대비 여유(기본 9.5GB). 초과 시 업로드 차단.
# STORAGE_MAX_BYTES="9500000000"

# Cloudflare R2 (STORAGE_DRIVER=r2 일 때 필수) — prod 이미지 스토리지
# R2_ACCOUNT_ID="..."
# R2_ACCESS_KEY_ID="..."
# R2_SECRET_ACCESS_KEY="..."
# R2_BUCKET="diary-photos"

# 공휴일(달력 빨간날) — 공공데이터포털 천문연 특일정보 API 인증키(Decoding 키).
# 미설정 시 공휴일 색은 표시되지 않는다(앱 동작엔 영향 없음).
# DATA_GO_KR_KEY="..."

# Web Push (좋아요 알림). 키 생성: pnpm exec web-push generate-vapid-keys --json
# 미설정 시 알림 토글이 숨겨지고 발송도 건너뛴다(앱 동작엔 영향 없음).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="B..."    # 클라이언트 노출용 공개키
# VAPID_PRIVATE_KEY="..."                # 서버 전용 비밀키(절대 커밋 금지)
# VAPID_SUBJECT="mailto:you@example.com" # 발신자 식별(mailto: 또는 https URL)

# 일정 하루 전 리마인더 cron(/api/cron/anniversary-reminder) 인가 시크릿.
# Vercel Cron이 `Authorization: Bearer <값>` 으로 호출한다. 미설정 시 라우트는 항상 401(fail-closed).
# 값 생성 예: openssl rand -base64 32 — Vercel 프로젝트 환경변수에도 동일하게 등록.
# CRON_SECRET="change-me-to-a-long-random-string"

# 로컬(dev)에서도 서비스워커를 등록해 푸시/알림 토글을 테스트하려면 1로 설정.
# 평소엔 끄는 걸 권장(dev SW가 HMR과 간섭할 수 있음). prod는 이 값과 무관하게 항상 등록.
# NEXT_PUBLIC_DEV_SW="1"
