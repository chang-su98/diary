// Prisma 7 — 새 prisma-client generator + driver adapter(Postgres/Neon)
// 문서: output 경로 필수, import는 ".../generated/prisma/client"

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // Postgres(Neon) — @prisma/adapter-pg로 연결
  // Prisma 7: 연결 URL은 스키마가 아닌 prisma.config.ts 에서 관리
  provider = "postgresql"
}

// 사용자 — 폐쇄형 2인 앱(공개 가입 없음). 계정은 시드로 생성.
model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  passwordHash String    @db.VarChar(255)
  displayName  String?   @db.VarChar(50) // 이름
  birthday     DateTime? // 생일
  email        String?   @db.VarChar(255) // 이메일
  avatar       String?   @db.Text // 프로필 사진 (data URL)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  anniversaries     Anniversary[] // 작성한 일정
  photos            Photo[] // 올린 사진
  photoLikes        PhotoLike[] // 누른 좋아요
  pushSubscriptions PushSubscription[] // 푸시 알림 구독(기기별)
  trips             Trip[] // 만든 여행 계획

  @@map("users")
}

// 웹 푸시 구독 — 기기/브라우저마다 1행. 좋아요 알림 발송 대상.
// 만료·해지된 구독(발송 시 404/410)은 발송 로직에서 정리한다.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique @db.Text // 푸시 서비스 엔드포인트(기기 식별)
  p256dh    String   @db.Text // 구독 공개키
  auth      String   @db.Text // 구독 인증 시크릿
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// 푸시 알림 발송 스로틀 — 같은 종류의 연속/일괄 이벤트(예: 사진 일괄 업로드)에서
// 디바운스 윈도우 동안 단 한 번만 발송하기 위한 원자적 게이트.
// key("이벤트:사용자id") 단위로 마지막 발송 시각을 기록하고, 조건부 updateMany로
// 발송권을 단일 호출에만 부여한다(동시 업로드 시 중복 발송 차단).
// 주의: key는 유한 카디널리티(이벤트:userId)여야 한다. id 기반 가변 key를 도입하면
// 행이 무한 증가하므로 그 경우 lastNotifiedAt 기준 TTL 정리가 필요하다.
model NotifyThrottle {
  key            String   @id // 예: "photo-upload:{userId}"
  lastNotifiedAt DateTime

  @@map("notify_throttles")
}

// 로그인 브루트포스 방어용 고정 윈도우 rate limit 카운터.
// key: "login:ip:{ip}" 또는 "login:user:{username}". windowStart 기준으로 count 누적.
// 만료 행은 rate-limit 로직이 새 윈도우 시작 시 정리한다(테이블 성장 제한).
model LoginRateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime

  @@map("login_rate_limits")
}

// 우리들의 일정 — 폐쇄형 2인 공유 일정.
// 인가 모델: 공유 — 로그인한 두 사용자 모두 누구의 일정이든 수정/삭제 가능(의도).
// authorId는 "누가 만들었는지" 표시용일 뿐 수정/삭제 권한을 제한하지 않는다.
model Anniversary {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(100) // 일정 제목
  date      DateTime // 일정(시작) 날짜 (UTC 자정 저장)
  endDate   DateTime? // 기간 일정 종료일(UTC 자정). 없으면 단일일. 1회성에서만 사용
  yearly    Boolean  @default(true) // 매년 반복 여부
  authorId  Int? // 작성자(User) — 삭제 시 null
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("anniversaries")
}

// 갤러리 사진 — 폐쇄형 2인 공유. 핀터레스트식 메이슨리로 표시.
// 이미지는 클라이언트에서 비율 유지 리사이즈 후 data URL(jpeg/png/webp)로 저장.
// width/height는 레이아웃 시프트 방지를 위한 원본 표시 비율.
// 이미지 바이트는 파일 스토리지(로컬 디스크/R2)에 저장하고 DB엔 key만 보관한다.
// data/thumb(base64)는 스토리지 도입 이전 사진의 폴백용으로 nullable 유지.
model Photo {
  id        Int      @id @default(autoincrement())
  dataKey   String? // 원본 스토리지 key (신규 업로드)
  thumbKey  String? // 썸네일 스토리지 key (신규 업로드)
  data      String?  @db.Text // (레거시) 원본 base64 — 스토리지 이전 사진 폴백
  thumb     String?  @db.Text // (레거시) 썸네일 base64 — 폴백
  width     Int // 표시 비율용 가로 px
  height    Int // 표시 비율용 세로 px
  bytes     Int      @default(0) // 현재 원본 바이트만 기록 — 스토리지 용량 가드용(썸네일 도입 시 합산)
  authorId  Int? // 올린 사람(User) — 삭제 시 null
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  likes     PhotoLike[] // 이 사진에 눌린 좋아요

  @@map("photos")
}

// 사진 좋아요 — 폐쇄형 2인 앱. 사용자당 사진 1개에 한 번(토글).
// 사진/사용자 삭제 시 함께 정리(Cascade).
model PhotoLike {
  id        Int      @id @default(autoincrement())
  photoId   Int
  userId    Int
  createdAt DateTime @default(now())
  photo     Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([photoId, userId]) // 사용자당 사진 1회만
  @@index([photoId]) // 사진별 개수 집계용
  @@map("photo_likes")
}

// 여행 계획 — 폐쇄형 2인 공유. 시작~종료일 사이의 각 날짜가 "N일차"가 되고,
// 일차마다 가고 싶은 장소(맛집 등)를 네이버 지도 링크와 함께 담는다.
// 일차는 별도 테이블 없이 startDate~endDate에서 파생한다(TripPlace.day = 1-based).
// 인가 모델은 Anniversary와 동일(공유) — authorId는 "누가 만들었는지" 표시용일 뿐
// 수정/삭제 권한을 제한하지 않는다.
model Trip {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(100) // 여행 제목
  startDate DateTime // 첫날(UTC 자정) = 1일차
  endDate   DateTime // 마지막날(UTC 자정). 당일치기면 startDate와 동일
  authorId  Int? // 작성자(User) — 삭제 시 null
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  places TripPlace[] // 일차별 장소

  @@map("trips")
}

// 여행 일차별 장소 — day는 1-based 일차 번호(1 = Trip.startDate).
// url은 네이버 지도 등 외부 링크(선택, https만). 여행 삭제 시 함께 정리(Cascade).
model TripPlace {
  id        Int      @id @default(autoincrement())
  tripId    Int
  day       Int // 1-based 일차
  name      String   @db.VarChar(100) // 장소 이름
  url       String?  @db.Text // 네이버 지도 링크(https)
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, day]) // 일차별 조회·정렬
  @@map("trip_places")
}
