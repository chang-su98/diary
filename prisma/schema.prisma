// Prisma 7 — 새 prisma-client generator + driver adapter(MariaDB)
// 문서: output 경로 필수, import는 ".../generated/prisma/client"

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // MariaDB는 mysql 커넥터를 사용한다 (@prisma/adapter-mariadb로 연결)
  // Prisma 7: 연결 URL은 스키마가 아닌 prisma.config.ts 에서 관리
  provider = "mysql"
}

// 사용자 — 폐쇄형 2인 앱(공개 가입 없음). 계정은 시드로 생성.
model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  passwordHash String    @db.VarChar(255)
  displayName  String?   @db.VarChar(50) // 이름
  birthday     DateTime? // 생일
  email        String?   @db.VarChar(255) // 이메일
  avatar       String?   @db.MediumText // 프로필 사진 (data URL)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@map("users")
}

// 우리들의 기념일 — 사용자가 추가/수정/삭제하는 공유 기념일
model Anniversary {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(100) // 기념일 제목
  date      DateTime // 기념일 날짜 (UTC 자정 저장)
  yearly    Boolean  @default(true) // 매년 반복 여부
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("anniversaries")
}
